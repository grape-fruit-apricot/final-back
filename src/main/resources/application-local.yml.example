# application-local.yml 템플릿
#
# 이 파일을 application-local.yml 로 복사해서 값을 채운다. 그 파일은 gitignore 대상이라
# 절대 커밋되지 않는다. 접속 정보와 API 키는 여기에만 둔다.
#
#   cp src/main/resources/application-local.yml.example src/main/resources/application-local.yml
#
# 값이 하나라도 비면 기동 시 "Could not resolve placeholder ..." 로 어떤 키가 빠졌는지
# 알려주며 실패한다. 자바 쪽에 기본값을 두지 않기 때문이다.
#
# 배포 서버에서는 이 파일을 컨테이너 바깥에 두고 마운트한다.
#   /opt/midpoint/main/config/application-local.yml     (운영)
#   /opt/midpoint/develop/config/application-local.yml  (개발)
# 컨테이너는 SPRING_CONFIG_ADDITIONAL_LOCATION=file:/config/ 로 이 파일을 읽는다.

spring:
  datasource:
    url: jdbc:oracle:thin:@호스트:포트:SID
    # 따옴표로 감싼다. 계정명에 # 가 들어가면 YAML 파서가 주석으로 볼 여지가 있다
    username: "계정명"
    password: "비밀번호"
    driver-class-name: oracle.jdbc.driver.OracleDriver
    hikari:
      # 학원 Oracle XE 는 전체 세션 수에 한계가 있다. 개발자 로컬까지 붙는 것을 감안해
      # 서버에서는 운영 10 / 개발 5 정도로 낮춰 쓴다. 로컬 개발은 5 면 충분하다.
      maximum-pool-size: 5
      connection-timeout: 5000
  jpa:
    hibernate:
      ddl-auto: none
    show-sql: true

server:
  port: 8080

mybatis:
  mapper-locations: classpath:mapper/**/*.xml
  type-aliases-package: com.kh.midpoint
  configuration:
    map-underscore-to-camel-case: true
    jdbc-type-for-null: VARCHAR

kakao:
  # 카카오 개발자 콘솔의 REST API 키(서버용). 프론트의 JavaScript 키와 다른 값이다
  rest-api-key: "발급받은_REST_API_키"
  transit:
    url: "https://dapi.kakao.com/v2/routing/publictraffic"

tmap:
  # SK open API 앱 키
  app-key: "발급받은_TMAP_앱키"

tracking:
  # 좌표를 보내는 디바이스(라즈베리파이)와 서버가 나눠 갖는 값.
  # 이 값을 아는 쪽만 좌표를 밀어넣을 수 있으므로 커밋하지 않는다.
  # 디바이스의 device/config.json 에 적은 deviceKey 와 똑같아야 한다.
  device-key: "디바이스에_설정한_키"

# --- 아래부터는 배포 서버에서만 채운다 ---
#
# application-constant.yml 의 값을 덮어쓰고 싶을 때 여기에 같은 키를 적는다.
# application.yml 의 프로파일 순서가 constant -> local 이라 local 이 이긴다.
# 커밋되는 constant 파일은 건드리지 않아도 된다.
#
# CORS 는 여기에 안 적어도 된다. application-constant.yml 에 로컬 주소와 배포 주소가
# 모두 들어 있다. 특정 환경만 더 좁히고 싶을 때만 아래처럼 덮어쓴다.
#
# cors:
#   allowed-origins: "https://midpoint.my,https://www.midpoint.my"   # 운영만 허용
#
# 만료된 방 정리는 기본이 꺼짐(application-constant.yml 의 cleanup.enabled: false)이다.
# develop 과 main 이 같은 Oracle 을 보기 때문에, 지우는 서버 한 곳에서만 켠다.
# 로컬에서는 켜지 않는 것을 권한다. 팀원이 쓰던 방까지 지워진다.
#
# cleanup:
#   enabled: true

# 로컬에서 상수를 잠깐 바꿔보고 싶을 때도 같은 방식으로 쓴다.
# game:
#   turn:
#     seconds: 3
