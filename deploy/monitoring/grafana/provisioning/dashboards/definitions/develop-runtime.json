    {
      "id": 2,
      "type": "timeseries",
      "title": "초당 요청 수",
      "description": "문서·Actuator 경로 제외. UNKNOWN 및 /** 요청은 포함됩니다.",
      "datasource": {
        "type": "prometheus",
        "uid": "midpoint-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_server_requests_seconds_count{job=\"midpoint-develop\",environment=\"develop\",uri!~\"/actuator.*|/v3/api-docs.*|/swagger-ui.*\"}[$__rate_interval]))",
          "legendFormat": "전체",
          "datasource": {
            "type": "prometheus",
            "uid": "midpoint-prometheus"
          },
          "range": true,
          "editorMode": "code"
